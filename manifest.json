{
  "manifest_version": 1,
  "id": "paradee",
  "version": "26.11.1",
  "display_name": "Paradee (offline, lightweight English)",
  "summary": "Paradee: natural English speech at 24 kHz from an 8M-parameter model distilled from Kokoro. Four voices, two American and two British, from one 8.5 MB model that downloads the first time a line is spoken. Runs on the CPU, many times faster than real time. English only.",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-paradee",
  "license": "GPL-3.0-or-later (add-on, because it bundles espeak-ng, GPL-3.0-or-later); Paradee weights Apache-2.0; misaki Apache-2.0; spaCy and its English pipeline MIT",
  "executable": "bin/paradee-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "tasks": [
    "tts.synthesize"
  ],
  "compute": "cpu",
  "voice_clone": false,
  "languages": [
    "en-us",
    "en-gb"
  ],
  "voices": [
    {
      "id": "heart",
      "language": "en-us",
      "display_name": "Heart (American English woman)",
      "sample_rate": 24000
    },
    {
      "id": "puck",
      "language": "en-us",
      "display_name": "Puck (American English man)",
      "sample_rate": 24000
    },
    {
      "id": "isabella",
      "language": "en-gb",
      "display_name": "Isabella (British English woman)",
      "sample_rate": 24000
    },
    {
      "id": "fable",
      "language": "en-gb",
      "display_name": "Fable (British English man)",
      "sample_rate": 24000
    }
  ],
  "models": [
    {
      "id": "paradee-1.2",
      "display_name": "Paradee 1.2 (7.9M, int8 ONNX, four voices)",
      "repo": "sahilmahendrakar/Paradee-8M-v1.2",
      "revision": "ed2934d4df8a4fd891e29584c5e1104649409765",
      "size_mb": 8,
      "license": "Apache-2.0",
      "bundled": false,
      "default": true
    }
  ],
  "disk_required_mb": 250,
  "ram_required_mb": 512,
  "config_schema": {
    "fields": [
      {
        "key": "threads",
        "type": "int",
        "label": "CPU threads",
        "default": 0,
        "min": 0,
        "max": 64,
        "step": 1,
        "help": "0 uses one thread, which already speaks many times faster than real time."
      },
      {
        "key": "speed",
        "type": "number",
        "label": "Speaking pace",
        "default": 1.0,
        "min": 0.5,
        "max": 2.0,
        "step": 0.05,
        "help": "How fast Paradee itself speaks: 1.0 is its natural pace, 1.2 is 20% faster. The dubbing rate slider still stretches the result afterwards."
      }
    ]
  }
}
